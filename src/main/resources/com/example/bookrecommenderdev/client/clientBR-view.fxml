<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import org.kordamp.ikonli.javafx.*?>

<BorderPane maxWidth="1.7976931348623157E308" prefHeight="632.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.bookrecommenderdev.client.controller.ClientBRController">
   <top>
      <HBox fx:id="navbar" alignment="CENTER" maxWidth="1.7976931348623157E308" prefHeight="70.0" prefWidth="1000.0" style="-fx-background-color: #d5d5d5; -fx-padding: 0 40 0 40; -fx-effect: dropshadow(three-pass-box, rgba(50,50,50,0.1), 5, 0, 0, 5);" BorderPane.alignment="CENTER">
         <Region HBox.hgrow="ALWAYS" />
         <HBox fx:id="navbarControls" alignment="CENTER" prefHeight="145.0" style="-fx-spacing: 20;">
            <Button fx:id="loginButton" layoutX="87.0" layoutY="59.0" mnemonicParsing="false" onAction="#onLogin" prefHeight="36.0" styleClass="login-button, navbar-button" text="Login">
               <font>
                  <Font size="15.0" />
               </font>
            </Button>
            <Button fx:id="registerButton" layoutX="121.0" layoutY="27.0" mnemonicParsing="false" onAction="#onRegister" prefHeight="36.0" styleClass="register-button, navbar-button" text="Registrati">
               <font>
                  <Font size="15.0" />
               </font>
            </Button>
            <Button contentDisplay="CENTER" mnemonicParsing="false" onAction="#onHomepage" prefHeight="48.0" prefWidth="48.0" style="-fx-background-color: transparent;" textAlignment="CENTER" HBox.hgrow="NEVER">
               <tooltip>
                  <Tooltip text="Pagina iniziale" />
               </tooltip>
               <graphic>
                  <FontIcon iconColor="#4E5498" iconLiteral="mdi2h-home" iconSize="32" />
               </graphic>
            </Button>
         </HBox>
      </HBox>
   </top>
   <center>
      <StackPane fx:id="centerStackContainer" maxWidth="1.7976931348623157E308" prefHeight="150.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <VBox fx:id="homePage" alignment="CENTER" prefHeight="200.0" prefWidth="100.0" visible="false">
            <Label fx:id="welcomeText" alignment="CENTER" contentDisplay="CENTER" prefHeight="60.0" prefWidth="369.0" text="BookRecommender" textAlignment="CENTER">
               <font>
                  <Font name="Constantia" size="32.0" />
               </font>
            </Label>
            <StackPane fx:id="searchbarWrapper" maxHeight="-Infinity" maxWidth="-Infinity" minWidth="500.0" prefHeight="60.0" prefWidth="640.0" style="-fx-background-color: white; -fx-border-radius: 5; -fx-border-width: 1; -fx-background-radius: 5; -fx-border-color: lightgrey;" styleClass="searchbar-center">
               <HBox alignment="CENTER" minWidth="-Infinity" prefWidth="213.0" style="-fx-padding: 0 10 0 10;">
                  <TextField fx:id="searchbar" focusTraversable="false" minHeight="-Infinity" prefWidth="0.0" promptText="Cerca..." style="-fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10; -fx-border-color: transparent; -fx-background-color: transparent;" HBox.hgrow="ALWAYS">
                     <font>
                        <Font name="Constantia" size="20.0" />
                     </font>
                  </TextField>
                  <Button fx:id="searchButton" contentDisplay="CENTER" mnemonicParsing="false" onMouseClicked="#onSearchAction" prefHeight="48.0" prefWidth="48.0" style="-fx-background-color: transparent;" textAlignment="CENTER" HBox.hgrow="NEVER">
                     <tooltip>
                        <Tooltip text="Cerca" />
                     </tooltip>
                     <graphic>
                        <FontIcon iconColor="#4E5498" iconLiteral="mdi2m-magnify" iconSize="38" />
                     </graphic>
                  </Button>
                  <Button contentDisplay="CENTER" mnemonicParsing="false" prefHeight="48.0" prefWidth="48.0" style="-fx-background-color: transparent;" textAlignment="CENTER" HBox.hgrow="NEVER">
                     <tooltip>
                        <Tooltip text="Criterio di ricerca" />
                     </tooltip>
                     <graphic>
                        <FontIcon iconColor="#4E5498" iconLiteral="mdi2t-table-filter" iconSize="32" />
                     </graphic>
                  </Button>
               </HBox>
            </StackPane>
            <Region fx:id="mainPageSpacer" prefHeight="60.0" prefWidth="1000.0" />
         </VBox>
         <ScrollPane fx:id="resultPage" fitToWidth="true" hbarPolicy="NEVER" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent;" styleClass="scroll-pane" visible="false">
            <VBox alignment="CENTER" focusTraversable="true" style="-fx-background-color: transparent;">
               <HBox fx:id="resultTitleWrapper" alignment="CENTER">
                     <Label fx:id="resultTitle" alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent;" text="Risultati" textAlignment="CENTER">
                        <font>
                           <Font name="Arial" size="24.0" />
                        </font>
                        <padding>
                           <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>
                     </Label>
                  <VBox.margin>
                     <Insets bottom="10.0" top="10.0" />
                  </VBox.margin>
               </HBox>
               <VBox fx:id="booksResultWrapper">
                  <HBox alignment="BOTTOM_LEFT">
                        <Label fx:id="resultIndexCounter" prefHeight="20.0" text="X-Y di Z risultati">
                           <padding>
                              <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
                           </padding>
                        </Label>
                  </HBox>
                  <VBox fx:id="booksResultDisplay" minHeight="-Infinity" minWidth="-Infinity" spacing="10.0" style="-fx-border-width: 1; -fx-border-color: #7896db; -fx-background-color: white;" VBox.vgrow="ALWAYS">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
                  <BorderPane VBox.vgrow="NEVER">
                     <left>
                        <Button fx:id="previousPageButton" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#onPreviousResults" prefHeight="40.0" prefWidth="105.0" text="Previous" BorderPane.alignment="CENTER">
                           <graphic>
                              <FontIcon iconLiteral="mdi2a-arrow-left" iconSize="38" styleClass="result-page-arrow" />
                           </graphic>
                        </Button>
                     </left>
                     <right>
                        <Button fx:id="nextPageButton" alignment="CENTER" contentDisplay="RIGHT" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#onNextResults" prefHeight="40.0" prefWidth="105.0" text="Next" BorderPane.alignment="CENTER">
                           <graphic>
                              <FontIcon iconLiteral="mdi2a-arrow-right" iconSize="38" styleClass="result-page-arrow" />
                           </graphic>
                        </Button>
                     </right>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                     <VBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </VBox.margin>
                  </BorderPane>
               </VBox>
               <padding>
                  <Insets left="120.0" right="120.0" />
               </padding>
            </VBox>
         </ScrollPane>
         <VBox fx:id="loginPage" alignment="CENTER" fillWidth="false" prefHeight="200.0" prefWidth="100.0" visible="false" StackPane.alignment="CENTER">
            <VBox alignment="CENTER" fillWidth="false" prefHeight="200.0" prefWidth="100.0" spacing="20.0" style="-fx-border-color: #41a2e5; -fx-border-width: 3; -fx-border-radius: 15;" VBox.vgrow="NEVER">
               <Label text="Login">
                  <font>
                     <Font name="Arial" size="30.0" />
                  </font>
               </Label>
               <Label fx:id="loginFeedback" styleClass="login-feedback-label" />
               <TextField fx:id="loginEmail" minHeight="-Infinity" minWidth="-Infinity" prefHeight="50.0" prefWidth="300.0" promptText="Email">
                  <font>
                     <Font size="18.0" />
                  </font></TextField>
               <TextField fx:id="loginPassword" layoutX="113.0" layoutY="113.0" minHeight="-Infinity" minWidth="-Infinity" prefHeight="50.0" prefWidth="300.0" promptText="Password">
                  <font>
                     <Font size="18.0" />
                  </font>
               </TextField>
               <HBox alignment="CENTER" spacing="20.0">
                     <Region prefWidth="75.0" />
                     <Button fx:id="confirmLoginButton" mnemonicParsing="false" onAction="#onConfirmLogin" text="Conferma">
                        <font>
                           <Font size="18.0" />
                        </font>
                     </Button>
                     <CheckBox fx:id="loginRicordaCredenziali" mnemonicParsing="false" prefWidth="75.0" text="Ricorda" />
               </HBox>
               <padding>
                  <Insets bottom="100.0" left="100.0" right="100.0" top="100.0" />
               </padding>
            </VBox>
         </VBox>
         <VBox fx:id="registerPage" alignment="CENTER" fillWidth="false" prefHeight="200.0" prefWidth="100.0" visible="false" StackPane.alignment="CENTER">
            <VBox alignment="CENTER" fillWidth="false" prefHeight="200.0" prefWidth="100.0" spacing="10.0" style="-fx-border-color: #7377d5; -fx-border-width: 15; -fx-border-radius: 20;" VBox.vgrow="NEVER">
               <Label text="Crea il tuo account">
                  <font>
                     <Font name="Arial" size="30.0" />
                  </font>
               </Label>
               <Label fx:id="registerFeedback" styleClass="login-feedback-label">
                  <VBox.margin>
                     <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                  </VBox.margin></Label>
               <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                  <TextField fx:id="registerName" minHeight="-Infinity" minWidth="-Infinity" prefHeight="50.0" promptText="Nome">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </TextField>
                  <TextField fx:id="registerSurname" layoutX="10.0" layoutY="10.0" minHeight="-Infinity" minWidth="-Infinity" prefHeight="50.0" promptText="Cognome">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </TextField>
               </HBox>
               <TextField fx:id="registerEmail" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" prefHeight="50.0" prefWidth="500.0" promptText="Email">
                  <font>
                     <Font size="18.0" />
                  </font></TextField>
               <TextField fx:id="registerPassword" layoutX="75.0" layoutY="206.0" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" prefHeight="50.0" prefWidth="500.0" promptText="Password">
                  <font>
                     <Font size="18.0" />
                  </font>
               </TextField>
               <TextField fx:id="registerCodiceFiscale" layoutX="75.0" layoutY="266.0" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" prefHeight="50.0" prefWidth="500.0" promptText="Codice fiscale">
                  <font>
                     <Font size="18.0" />
                  </font>
               </TextField>
               <HBox alignment="CENTER" spacing="20.0">
                     <Region prefWidth="75.0" />
                  <Button fx:id="confirmRegistrationButton" mnemonicParsing="false" onAction="#onConfirmRegistration" text="Conferma">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Button>
                     <CheckBox fx:id="registerRicordaCredenziali" mnemonicParsing="false" prefWidth="75.0" text="Ricorda" />
               </HBox>
               <padding>
                  <Insets bottom="75.0" left="50.0" right="50.0" top="75.0" />
               </padding>
            </VBox>
         </VBox>
         <VBox fx:id="profilePage" prefHeight="200.0" prefWidth="100.0" visible="false">
            <VBox prefHeight="200.0" prefWidth="693.0" VBox.vgrow="ALWAYS">
               <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#onLogout" text="Esci dall'account">
                  <VBox.margin>
                     <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                  </VBox.margin>
               </Button>
            </VBox>
         </VBox>
      </StackPane>
   </center>
</BorderPane>
