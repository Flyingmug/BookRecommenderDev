<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane fx:id="librariesPage" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.bookrecommenderdev.client.controller.LibrariesController" fitToWidth="true" hbarPolicy="NEVER" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent;" styleClass="scroll-pane">
   <VBox alignment="CENTER" focusTraversable="true" style="-fx-background-color: transparent;">
      <HBox fx:id="librariesTitleWrapper" alignment="CENTER">
         <Label fx:id="librariesResultTitle" alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent;" text="Risultati" textAlignment="CENTER">
            <font>
               <Font name="Arial" size="24.0" />
            </font>
            <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
         </Label>
         <VBox.margin>
            <Insets bottom="10.0" top="10.0" />
         </VBox.margin>
      </HBox>
      <VBox fx:id="booksResultWrapper">
         <HBox alignment="BOTTOM_LEFT">
            <Label fx:id="resultIndexCounter" prefHeight="20.0" text="X-Y di Z risultati">
               <padding>
                  <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
               </padding>
            </Label>
         </HBox>
         <VBox fx:id="booksResultDisplay" minHeight="-Infinity" minWidth="-Infinity" spacing="10.0" style="-fx-border-width: 1; -fx-border-color: #7896db; -fx-background-color: white;" VBox.vgrow="ALWAYS">
            <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
         </VBox>
         <BorderPane VBox.vgrow="NEVER">
            <left>
               <Button fx:id="previousPageButton" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#onPreviousResults" prefHeight="40.0" prefWidth="105.0" text="Precedente" BorderPane.alignment="CENTER">
                  <graphic>
                     <FontIcon iconLiteral="mdi2a-arrow-left" iconSize="38" styleClass="result-page-arrow" />
                  </graphic>
               </Button>
            </left>
            <right>
               <Button fx:id="nextPageButton" alignment="CENTER" contentDisplay="RIGHT" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#onNextResults" prefHeight="40.0" prefWidth="105.0" text="Successivo" BorderPane.alignment="CENTER">
                  <graphic>
                     <FontIcon iconLiteral="mdi2a-arrow-right" iconSize="38" styleClass="result-page-arrow" />
                  </graphic>
               </Button>
            </right>
            <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <VBox.margin>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </VBox.margin>
         </BorderPane>
      </VBox>
      <padding>
         <Insets left="120.0" right="120.0" />
      </padding>
   </VBox>
</ScrollPane>
