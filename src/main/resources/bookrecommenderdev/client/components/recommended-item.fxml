<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns:fx="http://javafx.com/fxml" xmlns="http://javafx.com/javafx"
      fx:controller="bookrecommenderdev.client.controller.components.RecommendedItemController"
      styleClass="book-item">

   <HBox>
      <FontIcon iconLiteral="mdi2b-book-account-outline" styleClass="recommend-item-count-icon" />
      <Label fx:id="recommendCountLabel"
             text="N/A"
             styleClass="recommend-item-count-label"/>
   </HBox>

   <VBox HBox.hgrow="ALWAYS">
      <Button fx:id="linkButton" styleClass="book-item-link">
         <graphic>
            <Label fx:id="titleLabel" styleClass="book-item-link-text" />
         </graphic>
      </Button>
      <Label fx:id="authorLabel" styleClass="book-item-label" />
      <Label fx:id="yearLabel" styleClass="book-item-label" />
   </VBox>

</HBox>
