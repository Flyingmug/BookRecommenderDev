<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane fx:id="booksResultsPage"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="bookrecommenderdev.client.controller.SearchResultsController"
            fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER"
            styleClass="scrollable-pane">

   <HBox styleClass="search-page-container">
      <VBox styleClass="search-page">
         <HBox fx:id="resultTitleContainer" styleClass="result-title-container" alignment="CENTER">
            <Label fx:id="resultTitle" text="Risultati" />
            <HBox fx:id="resultNotFoundTitle" managed="false" visible="false">
               <Label styleClass="" text="Nessun risultato trovato" />
               <FontIcon iconLiteral="mdi2b-book-alert-outline" iconSize="38" />
            </HBox>
            <HBox.margin>
               <Insets bottom="10.0" top="10.0" />
            </HBox.margin>
         </HBox>
         <VBox fx:id="booksResultSection">

            <HBox alignment="BOTTOM_LEFT">
               <Label fx:id="resultIndexCounter" styleClass="results-index-counter"
                      text="/-/ di / risultati" />
            </HBox>

            <VBox fx:id="booksResultsContainer" styleClass="search-results-container" VBox.vgrow="ALWAYS" />

            <BorderPane styleClass="search-controls-container">
               <left>
                  <Button fx:id="previousPageButton" styleClass="control-button"
                          BorderPane.alignment="CENTER"
                          onAction="#onPreviousResults"
                          visible="false"
                          text="Precedente">
                     <graphic>
                        <FontIcon iconLiteral="mdi2a-arrow-left" styleClass="result-page-arrow" />
                     </graphic>
                  </Button>
               </left>
               <right>
                  <Button fx:id="nextPageButton" styleClass="control-button"
                          BorderPane.alignment="CENTER"
                          onAction="#onNextResults"
                          visible="false"
                          text="Successivo">
                     <graphic>
                        <FontIcon iconLiteral="mdi2a-arrow-right" styleClass="result-page-arrow" />
                     </graphic>
                  </Button>
               </right>
            </BorderPane>
         </VBox>
      </VBox>
   </HBox>


</ScrollPane>
