<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="bookrecommenderdev.client.controller.LoginController"
      alignment="CENTER" fillWidth="false" StackPane.alignment="CENTER">

   <Region prefHeight="50.0" />

   <VBox styleClass="login-page" VBox.vgrow="NEVER" fillWidth="false">
      <Label text="Accedi al tuo account" styleClass="regular-30" />
      <Label fx:id="loginFeedback" styleClass="login-feedback-label" />
      <TextField fx:id="loginUserId" styleClass="login-field, regular-17" promptText="User id" />
      <TextField fx:id="loginPassword" styleClass="login-field, regular-17" promptText="Password"/>
      <HBox styleClass="login-controls-container">
         <Region prefWidth="75.0" />
         <Button fx:id="confirmLoginButton" styleClass="control-button, control-button-border, login-control-button, regular-17"
                 onAction="#onLogin" text="Accedi"/>
         <CheckBox fx:id="loginRicordaCredenziali" text="Ricorda" styleClass="regular-14" />
      </HBox>
   </VBox>

   <Region VBox.vgrow="ALWAYS" />

   <Region prefHeight="50.0" />

</VBox>
